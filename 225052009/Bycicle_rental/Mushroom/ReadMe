
        
package com.mycompany.quitbuttonexample;

import java.awt.GridLayout;
import java.awt.BorderLayout;
import javax.swing.*;

public class Lab1 extends JFrame {

    private JTextField startTimeField;
    private JTextField endTimeField;

    public Lab1() {
        setTitle("Lab 1 - Rental Calculations");
        setSize(550, 300);
        setLocationRelativeTo(null);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);

       
        JPanel mainPanel = new JPanel(new BorderLayout(10, 10));

    
        JPanel inputPanel = new JPanel(new GridLayout(2, 2, 10, 10));

        JLabel startLabel = new JLabel("Enter starting time (0-23):");
        startTimeField = new JTextField();

        JLabel endLabel = new JLabel("Enter ending time (1-24):");
        endTimeField = new JTextField();

        inputPanel.add(startLabel);
        inputPanel.add(startTimeField);
        inputPanel.add(endLabel);
        inputPanel.add(endTimeField);

        
        JButton calculateButton = new JButton("Calculate");
        JButton goToLab2Button = new JButton("Go to Lab 2");
        JButton quitButton = new JButton("Quit");

        JPanel buttonPanel = new JPanel();

        buttonPanel.add(calculateButton);
        buttonPanel.add(goToLab2Button);
        buttonPanel.add(quitButton);

        mainPanel.setBorder(
            BorderFactory.createEmptyBorder(25, 25, 25, 25)
        );

        mainPanel.add(inputPanel, BorderLayout.CENTER);
        mainPanel.add(buttonPanel, BorderLayout.SOUTH);

        add(mainPanel);

    
        calculateButton.addActionListener(e -> calculateCost());

    
        goToLab2Button.addActionListener(e -> {
            dispose();
            new Lab2().setVisible(true);
        });

        
        quitButton.addActionListener(e -> {
            int choice = JOptionPane.showConfirmDialog(
                this,
                "Are you sure you want to quit?",
                "Exit Application",
                JOptionPane.YES_NO_OPTION
            );

            if (choice == JOptionPane.YES_OPTION) {
                System.exit(0);
            }
        });
    }

    private void calculateCost() {

        try {
            int startTime = Integer.parseInt(
                startTimeField.getText().trim()
            );

            int endTime = Integer.parseInt(
                endTimeField.getText().trim()
            );

          
            if (startTime < 0 || startTime > 23 ||
                endTime < 1 || endTime > 24 ||
                startTime >= endTime) {

                JOptionPane.showMessageDialog(
                    this,
                    "Invalid time! Please enter the correct time.",
                    "Input Error",
                    JOptionPane.ERROR_MESSAGE
                );

                return;
            }

            int total = 0;

            // Calculate rental cost
            for (int hour = startTime; hour < endTime; hour++) {

                if (hour < 7) {
                    total += 500;
                }
                else if (hour < 14) {
                    total += 1000;
                }
                else if (hour < 19) {
                    total += 1500;
                }
                else if (hour < 21) {
                    total += 1000;
                }
                else {
                    total += 500;
                }
            }

          
            JOptionPane.showMessageDialog(
                this,
                "Starting Time: " + startTime +
                "\nEnding Time: " + endTime +
                "\n\nTotal Rental Cost: " + total + " RWF",
                "Calculation Result",
                JOptionPane.INFORMATION_MESSAGE
            );

        } catch (NumberFormatException ex) {

            JOptionPane.showMessageDialog(
                this,
                "Please enter valid whole numbers!",
                "Input Error",
                JOptionPane.ERROR_MESSAGE
            );
        }
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> {
            new Lab1().setVisible(true);
        });
    }
}

