            </Property>
            <Property name="text" type="java.lang.String" value="&lt;html&gt; &lt;body style=&quot;font-family: sans-serif; font-size: 11px; padding: 5px;&quot;&gt;     &lt;b style=&quot;color: #2B579A;&quot;&gt;Mushroom Classifier Instructions:&lt;/b&gt;     &lt;ol style=&quot;margin-left: 15px; padding-left: 0;&quot;&gt;         &lt;li&gt;Select whether the mushroom grows in a &lt;b&gt;Forest&lt;/b&gt; or &lt;b&gt;Meadow&lt;/b&gt;.&lt;/li&gt;         &lt;li&gt;Specify if it features a &lt;b&gt;Convex Cup&lt;/b&gt; structure.&lt;/li&gt;         &lt;li&gt;Answer the dynamic 3rd condition contextually.&lt;/li&gt;         &lt;li&gt;Click &lt;b&gt;CHECK MUSHROOM&lt;/b&gt; to process data.&lt;/li&gt;     &lt;/ol&gt; &lt;/body&gt; &lt;/html&gt; "/>
          </Properties>
        </Component>
      </SubComponents>
